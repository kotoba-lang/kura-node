{:paths ["src"]
 :version "0.1.0"
 ;; erasure    — the oracle the fast multiply-accumulate is proven equal to.
 ;; kura       — the decisions this layer executes (orders, audit challenges).
 ;; merkle-sum — reached through kura.audit; declared because we build trees.
 ;; sigv4      — request signing for the S3-compatible backend.
 :deps {io.github.kotoba-lang/erasure
        {:git/url "https://github.com/kotoba-lang/erasure.git"
         :git/sha "6b6b95eb8f5733b468e569c59eb58b492e6dc08b"}
        io.github.kotoba-lang/kura
        {:git/url "https://github.com/kotoba-lang/kura.git"
         :git/sha "625aae958638ae5a59e53e502b28492ae4524099"}
        io.github.kotoba-lang/merkle-sum
        {:git/url "https://github.com/kotoba-lang/merkle-sum.git"
         :git/sha "5bb473aed0c0bba6c0ae758d000a6142a5d79891"}
        io.github.kotoba-lang/sigv4
        {:git/url "https://github.com/kotoba-lang/sigv4.git"
         :git/sha "477e2b0c183f0e2cbefa2488e7f9133775d2840d"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;;   clojure -M:cljs -m cljs.main --target node -m kura.node.cljs-runner
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
